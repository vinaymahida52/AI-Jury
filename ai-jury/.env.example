# ---------------------------------------------------------------------------
# Template. Copy to .env and edit:  cp .env.example .env
# Switch AIJURY_PROVIDER to "anthropic" and fill in the key when you're ready.
# Never commit this file — .gitignore already excludes it.
# ---------------------------------------------------------------------------

# Provider: "mock" (offline), or seat a gateway in the console (HCNSEC, Tokenera, …).
# The console dock writes keys to .aijury/gateways.json — do not commit that file.
AIJURY_PROVIDER=mock

# Optional bootstrap if you prefer env over the dock (still OpenAI-compatible):
# AIJURY_PROVIDER=hcnsec
# HCNSEC_API_KEY=
# AIJURY_OPENAI_BASE_URL=https://api.hcnsec.cn/v1
# AIJURY_MODEL=Qwen3.8-27B
# AIJURY_API_KEY=

# Required when AIJURY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AIJURY_MODEL=

# Optional: one model per juror, comma separated. A heterogeneous panel is the
# point of a jury — five copies of one model share one set of blind spots.
AIJURY_MODEL_POOL=

# --- Safety ceilings (the console does not set these; the panel decides) ---
# Rounds stop on consensus, grey area, or oscillation first. This is last-resort.
AIJURY_MAX_ROUNDS=16
# Hard ceiling on panel size. The Framer chooses how many jurors the question needs.
AIJURY_MAX_JURORS=8
# Rounds of unchanged-but-divergent positions before we call it a grey area.
AIJURY_STABILITY_WINDOW=2
# Below this confidence the system reports UNRESOLVED rather than asserting.
AIJURY_CONFIDENCE_FLOOR=0.45

# --- Hard ceilings (any breach terminates deliberation immediately) --------
AIJURY_TOKEN_BUDGET=200000
AIJURY_MAX_LLM_CALLS=120
AIJURY_WALL_CLOCK_SECONDS=300

# --- Storage ---------------------------------------------------------------
AIJURY_TRACE_DIR=.traces
AIJURY_FAILURE_DIR=.failures
AIJURY_SEED=7
